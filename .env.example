# ==========================================================
# Al-Kitab Public Elementary School - Jhang
# Environment Variables (copy this file to .env and fill values)
# ==========================================================

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/alkitab_school?schema=public"

# NextAuth
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-this-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"
